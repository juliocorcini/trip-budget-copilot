<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Default notification icon for FCM + Capacitor LocalNotifications.
             Must be a white-on-transparent drawable (Android status bar requirement). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- B2 (Onda 4 / DEC-215): App Links — open /pair and /s/:id inside the
                 app. autoVerify pairs with /.well-known/assetlinks.json served at
                 the apex (trippilot.pages.dev). The #fragment carries the /s key
                 and the /pair identity; verified to survive on device. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/pair" />
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/s/" />
                <!-- DEC-459: widget "+" and quick tile deep-link here (setPackage
                     pins the intent to this app, so no chooser ever appears). -->
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/quick-add" />
                <!-- DEC-468: widget-suite tap targets (converter keypad hand-off,
                     receipt scan, outing start, expense list). -->
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/converter" />
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/receipt/scan" />
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/outings/new" />
                <data android:scheme="https" android:host="trippilot.pages.dev" android:pathPrefix="/expenses" />
            </intent-filter>

            <!-- B1 (Onda 4 / DEC-215): receive a .csv shared from another app
                 (Wise/Files "Share"). CSV-specific MIME types only, so generic
                 text shares are NOT hijacked. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
            </intent-filter>

            <!-- B1: open a .csv directly from a file manager ("Open with"). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/csv" />
                <data android:scheme="file" android:mimeType="text/csv" />
                <data android:scheme="content" android:mimeType="text/comma-separated-values" />
                <data android:scheme="file" android:mimeType="text/comma-separated-values" />
                <data android:scheme="content" android:mimeType="application/csv" />
                <data android:scheme="file" android:mimeType="application/csv" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- N5/N6 (Gate 3): background handler for the active-outing notification's
             quick-add value buttons. exported=false — only the app's own
             PendingIntents reach it. -->
        <receiver
            android:name=".OutingActionReceiver"
            android:exported="false" />

        <!-- DEC-459: "Livre hoje" home-screen widget. exported=true is required
             for the launcher to deliver APPWIDGET_UPDATE broadcasts. -->
        <receiver
            android:name=".HomeWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_info" />
        </receiver>

        <!-- DEC-468: converter + calculator widget (keypad broadcasts are
             self-targeted explicit intents — safe with exported=true, which
             the launcher requires anyway). -->
        <receiver
            android:name=".ConverterWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/converter_widget_info" />
        </receiver>

        <!-- DEC-468: quick actions widget. -->
        <receiver
            android:name=".QuickActionsWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/actions_widget_info" />
        </receiver>

        <!-- DEC-468: metas (occasion counters) widget. -->
        <receiver
            android:name=".MetasWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/metas_widget_info" />
        </receiver>

        <!-- DEC-468: piggy bank widget. -->
        <receiver
            android:name=".PiggyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/piggy_widget_info" />
        </receiver>

        <!-- DEC-468: next event widget. -->
        <receiver
            android:name=".NextEventWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/event_widget_info" />
        </receiver>

        <!-- DEC-468: "Hoje" (today's spend) widget. -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- DEC-459: Quick Settings tile → /quick-add. Permission + exported are
             mandated by the TileService contract. -->
        <service
            android:name=".QuickAddTileService"
            android:exported="true"
            android:label="@string/tile_quick_add_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- N5: opt-in expense location capture (Capacitor Geolocation). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- FIELD R2 item 12: QR scanner camera (getUserMedia). Capacitor 8 requests
         the runtime grant in onPermissionRequest, but only if it is declared here;
         without this line Android denies the request before any prompt is shown. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- DEC-246 (AI Quick Entry · voice): microphone for getUserMedia({audio}) →
         MediaRecorder → Whisper transcription. Same Capacitor rule as CAMERA: the
         WebView only prompts for the runtime grant when the permission is declared
         here. Without it Android denied the mic with NO prompt, so the mic icon
         flipped and vanished (device test 2026-06-20). Needs an APK rebuild — an
         OTA bundle cannot add a native permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- N6: active-outing notifications (Capacitor LocalNotifications, Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- B1/B2 (Gate 4): Live Update / Now Bar — promoted ongoing notification (Android 16+). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- DEC-210: in-app APK self-update — download the new APK and hand it to the
         system package installer (the OS still shows its own confirm screen). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
