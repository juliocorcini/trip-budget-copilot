<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — next event widget. DEFAULT (best) size is 3x1: name +
     countdown chip. 1x1 shows the day count; taller reveals date + reserve. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_event"
    android:previewLayout="@layout/widget_event"
    android:widgetCategory="home_screen"
    android:description="@string/widget_event_description" />
