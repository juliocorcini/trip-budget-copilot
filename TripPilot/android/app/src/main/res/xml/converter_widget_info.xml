<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468/2.7.1 — calculator-first widget with FX toggle. DEFAULT (best)
     size is 3x3: dense keypad + live result (Julio: "a calculadora a partir
     de 3 de altura"). Resizable down to 1x1; buckets: mini (1x1) → row (Nx1)
     → compact (2x2) → full3 (3 rows, dense keypad) → full (4+ rows, comfy
     keypad + currency chips row). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_converter_full3"
    android:previewLayout="@layout/widget_converter_full3"
    android:widgetCategory="home_screen"
    android:description="@string/widget_converter_description" />
