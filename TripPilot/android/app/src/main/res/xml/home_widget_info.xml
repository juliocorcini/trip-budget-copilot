<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-459 — "Livre hoje" widget metadata. updatePeriodMillis=0: the app
     pushes updates (widget renders last-known value; no polling, no battery
     cost). 3x1 default footprint, horizontally resizable. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_free_today"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
