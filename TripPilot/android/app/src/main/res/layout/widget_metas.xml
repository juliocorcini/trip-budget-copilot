<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — metas DEFAULT bucket (3x2): header + up to 6 meta rows (the
     provider shows 3 by default and reveals more as the widget grows tall).
     Mirrors the home occasion carousel: planned metas first, then activity
     counts — including the "N antigas" pre-plan history (BUG 2026-07-05). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/metas_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:text="@string/widget_metas_default" />

    <LinearLayout
        android:id="@+id/meta_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/meta_emoji_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/meta_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="#F8FAFC"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/meta_count_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2DD4BF" />

        <TextView
            android:id="@+id/meta_detail_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="10sp"
            android:textColor="#64748B"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
