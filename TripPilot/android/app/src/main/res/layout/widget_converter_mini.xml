<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — converter 1x1 bucket: pair + last converted value; tap opens
     the in-app converter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <TextView
        android:id="@+id/conv_pair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="9sp"
        android:textStyle="bold"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:text="@string/widget_converter_pair_default" />

    <TextView
        android:id="@+id/conv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#2DD4BF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_value_empty" />
</LinearLayout>
