<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — converter compact bucket (2x2 / 3x2): currency chips +
     expression + converted + rate stamp. Keys need >=3x3; here the body
     opens the in-app converter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/conv_from_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/widget_chip"
            android:text="@string/widget_converter_from_default" />

        <TextView
            android:id="@+id/conv_swap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2DD4BF"
            android:text="@string/widget_converter_swap" />

        <TextView
            android:id="@+id/conv_to_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:background="@drawable/widget_chip"
            android:text="@string/widget_converter_to_default" />

        <TextView
            android:id="@+id/conv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2DD4BF"
            android:text="↻" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/conv_fx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="12sp"
            android:background="@drawable/widget_chip"
            android:text="💱" />
    </LinearLayout>

    <TextView
        android:id="@+id/conv_expr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:ellipsize="start" />

    <TextView
        android:id="@+id/conv_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2DD4BF"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_value_empty" />

    <TextView
        android:id="@+id/conv_stamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textSize="9sp"
        android:textColor="#64748B"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
