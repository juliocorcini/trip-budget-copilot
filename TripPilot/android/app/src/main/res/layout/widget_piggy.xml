<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — piggy bank DEFAULT bucket (2x2): settled balance + savings-goal
     progress. Numbers come from the home cofrinho card (DEC-464 semantics). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/piggy_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:text="@string/widget_piggy_default" />

    <TextView
        android:id="@+id/piggy_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/widget_value_empty" />

    <ProgressBar
        android:id="@+id/piggy_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/piggy_goal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="11sp"
        android:textColor="#64748B"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone" />
</LinearLayout>
