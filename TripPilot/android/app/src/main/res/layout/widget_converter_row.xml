<?xml version="1.0" encoding="utf-8"?>
<!-- DEC-468 — converter row bucket (Nx1): expression + converted + swap.
     No keypad at this height; body opens the in-app converter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/conv_expr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:maxLines="1"
            android:ellipsize="start" />

        <TextView
            android:id="@+id/conv_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#2DD4BF"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/widget_value_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/conv_swap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:background="@drawable/widget_chip"
        android:maxLines="1"
        android:text="@string/widget_converter_pair_default" />
</LinearLayout>
