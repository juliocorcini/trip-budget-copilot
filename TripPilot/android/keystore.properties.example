# TripPilot — Android release signing (TEMPLATE)
#
# 1. Copy this file to `keystore.properties` (same folder). The real file is gitignored.
# 2. Generate an UPLOAD keystore once (keep it forever + back it up in a safe place —
#    losing it means you can no longer update the app under the same upload identity):
#
#    keytool -genkey -v \
#      -keystore trippilot-upload.jks \
#      -alias trippilot \
#      -keyalg RSA -keysize 2048 -validity 10000
#
#    Move trippilot-upload.jks into TripPilot/android/ (it is gitignored).
# 3. Fill the values below with the passwords/alias you chose.
#
# storeFile is resolved relative to the android/ folder (rootProject).

storeFile=trippilot-upload.jks
storePassword=CHANGE_ME
keyAlias=trippilot
keyPassword=CHANGE_ME
