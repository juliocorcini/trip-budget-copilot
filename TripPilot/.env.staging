# DEC-374 — environment isolation for STAGING builds (`npm run preview:staging`
# or any `vite ... --mode staging`). Points the client at the staging sync worker
# so a local preview build never touches the production Durable Objects budget.
# Loaded ONLY when Vite runs in `staging` mode; production builds are untouched.
VITE_SYNC_WORKER_URL=https://trippilot-sync-staging.trippilot.workers.dev
