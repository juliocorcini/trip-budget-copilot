{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trippilot-sync",
  "account_id": "e146e88b34b2694243b1d74cee8de743",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // DEC-439 (SEC-2, 2026-07-03 audit) — native Workers rate limiting (GA).
  // Three classes keyed by `installId || CF-Connecting-IP` in code:
  //   RL_AI          20/min — Groq proxies (/ocr /unit-extract /assistant /transcribe);
  //                  protects the free Groq quota (RPD) from a single abuser/bug loop.
  //   RL_INGEST      30/min — /t and /e (telemetry + error ingest).
  //   RL_SHARE_WRITE 60/min — share/mailbox/img WRITES only; reads + WS stay
  //                  unlimited so the live split polling can never be throttled.
  // Counters are per Cloudflare location (permissive by design); absence of the
  // binding fails OPEN in code (Â-RL-FAIL-OPEN).
  "ratelimits": [
    {
      "name": "RL_AI",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_INGEST",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_SHARE_WRITE",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "SyncRoom"
      },
      {
        "name": "MAILBOX",
        "class_name": "Mailbox"
      },
      {
        // DEC-207 S7 — real-time signal relay (transport only; no storage).
        "name": "SHARE_SIGNAL",
        "class_name": "ShareSignal"
      },
      {
        // DEC-207 — strongly-consistent share store (statement + responses).
        // Replaces KV for the live table: a DO gives read-after-write so a
        // guest's pick is visible to the next poll (KV's eventual consistency
        // froze the table on real devices).
        "name": "SHARE_STORE_DO",
        "class_name": "ShareStore"
      },
      {
        // DEC-248 — single global SQLite DO holding anonymous, NON-MONETARY
        // usage telemetry (installs + heartbeats). idFromName('global').
        "name": "TELEMETRY",
        "class_name": "TelemetryStore"
      }
    ]
  },
  // DEC-207 (Shared Participant Link): persistent, re-readable encrypted share
  // channel. KV is a pure id→ciphertext store with native per-key TTL and is
  // portable (values are self-contained ciphertext; migrate by copying keys to
  // any KV/object store — no proprietary schema, satisfying "no lock-in").
  "kv_namespaces": [
    {
      "binding": "SHARE_STORE",
      "id": "2807b56d02c04ce385fa3bc5bf6565bf"
    },
    {
      "binding": "PUSH_SUBS",
      "id": "18e0c0be69714a43be0c70b14a5265ea"
    }
  ],
  // DEC-348 (G2, this wave — REVERSES DEC-342/343 image E2E): R2 bucket for
  // ACCESS-CONTROLLED PLAINTEXT images. The Worker stores the real image bytes
  // with their true Content-Type (image/jpeg|png|webp|gif; legacy ciphertext
  // objects stay application/octet-stream) so a no-app `/g/` web guest can
  // `<img src>` / download them. Secrecy = an unguessable r2Id (handed out only
  // inside the still-E2E share payload) + per-object TTL (customMetadata.expiresAt,
  // enforced on GET) + delete-on-revoke. DEC-207 unchanged: messages/debts/names
  // STAY ciphertext-only — images are the single carve-out. Per-object cap is the
  // abuse guard; set a ~$1 dashboard budget alert as the cost backstop (R2 free
  // tier: 10 GB + 1M Class-A + 10M Class-B / mo). Created via
  // `wrangler r2 bucket create trippilot-media`.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "trippilot-media"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SyncRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Mailbox"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ShareSignal"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ShareStore"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["TelemetryStore"]
    }
  ]
}
